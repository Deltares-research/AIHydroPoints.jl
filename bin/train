#!/usr/bin/env bash
# bin/train — run the AIHydroPoints training pipeline
#
# Usage:
#   bin/train path/to/settings.toml [--continue|--overwrite]

REPO="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPT="$REPO/scripts/train.jl"
TOML="$(realpath "$1")"
shift
FLAGS=("$@")

if command -v pixi &>/dev/null; then
    exec pixi run julia "--project=$REPO" "$SCRIPT" "$TOML" "${FLAGS[@]}"
elif command -v julia &>/dev/null; then
    exec julia "--project=$REPO" "$SCRIPT" "$TOML" "${FLAGS[@]}"
else
    echo "Error: neither 'pixi' nor 'julia' found on PATH." >&2
    echo "Install Julia (https://julialang.org/downloads) or pixi (https://pixi.sh)." >&2
    exit 1
fi
