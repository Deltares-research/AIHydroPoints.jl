#!/usr/bin/env bash
# bin/serve — serve a trained AIHydroPoints model over KServe's V2 REST API
#
# Usage:
#   MODEL_DIR=path/to/model_dir bin/serve

REPO="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPT="$REPO/scripts/serve.jl"

if command -v pixi &>/dev/null; then
    exec pixi run julia "--project=$REPO" "$SCRIPT"
elif command -v julia &>/dev/null; then
    exec julia "--project=$REPO" "$SCRIPT"
else
    echo "Error: neither 'pixi' nor 'julia' found on PATH." >&2
    echo "Install Julia (https://julialang.org/downloads) or pixi (https://pixi.sh)." >&2
    exit 1
fi
